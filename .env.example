# Copia como .env (solo la primera vez):  cp -n .env.example .env
OLLAMA_URL=http://localhost:11434
MODEL=deepseek-r1:14b

# Razonamiento del modelo (deepseek-r1 "piensa" antes de responder).
# Se guarda en runs/<run>/<plantilla>/razonamiento.txt
THINK=true

# Reproducibilidad: temperatura 0 y semilla fija
TEMPERATURE=0
SEED=42

# Tokens: NUM_PREDICT incluye el razonamiento; si las respuestas salen cortadas, súbelo
NUM_CTX=8192
NUM_PREDICT=8192
# Segundos de espera por respuesta (un modelo de 14B puede tardar varios minutos)
REQUEST_TIMEOUT=900

# Valores por defecto de la CLI
DEFAULT_IDIOMA=español
DEFAULT_AUDIENCIA=investigadores y estudiantes de doctorado

TEMPLATES_PATH=plantillas
RUNS_DIR=runs
LOG_LEVEL=INFO
